{
  "realm": "inventario",
  "enabled": true,
  "displayName": "Inventario",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "inventario-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "${env.FRONTEND_URL}/*"
      ],
      "webOrigins": [
        "${env.FRONTEND_URL}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${env.FRONTEND_URL}/*"
      }
    }
  ],
  "users": [
    {
      "id": "10000000-0000-0000-0000-000000000001",
      "username": "${env.DEFAULT_USER}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Demo",
      "email": "${env.DEFAULT_USER}@inventario.com",
      "credentials": [
        {
          "type": "password",
          "value": "${env.DEFAULT_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
